{
  "name": "express-intercept",
  "description": "Build Express middleware to intercept / replace / inspect / transform response",
  "version": "1.4.0",
  "author": "Yusuke Kawasaki <u-suke@kawa.net>",
  "bugs": {
    "url": "https://github.com/kawanet/express-intercept/issues"
  },
  "contributors": [
    "Yusuke Kawasaki <u-suke@kawa.net>"
  ],
  "dependencies": {
    "async-request-handler": "^1.1.2"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-multi-entry": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-sucrase": "^5.1.0",
    "@types/express": "^4",
    "@types/express4": "npm:@types/express@^4",
    "@types/express5": "npm:@types/express@^5",
    "@types/node": "^24.12.2",
    "@types/supertest": "^7.2.0",
    "express4": "npm:express@^4",
    "express5": "npm:express@^5",
    "middleware-supertest": "^1.2.3",
    "rollup": "^4.62.0",
    "supertest": "^7.2.2",
    "ts-refine": "^0.6.0",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./types/express-intercept.d.ts",
      "require": "./dist/express-intercept.cjs",
      "import": "./dist/express-intercept.mjs"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/express-intercept.cjs",
    "dist/express-intercept.mjs",
    "lib/*.ts",
    "types/*.d.ts"
  ],
  "homepage": "https://github.com/kawanet/express-intercept#readme",
  "keywords": [
    "expressjs",
    "inspector",
    "interceptor",
    "middleware",
    "modify",
    "response",
    "tamper"
  ],
  "license": "MIT",
  "main": "./dist/express-intercept.cjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawanet/express-intercept.git"
  },
  "scripts": {
    "build": "make -C builder",
    "fixpack": "fixpack",
    "prepack": "make -C builder is-buildable",
    "prepare": "make -C builder is-not-buildable 2> /dev/null || make -C builder clean all test",
    "test": "make -C builder test",
    "test-bundled": "node --test builder/tests/bundled.js",
    "ts-refine": "./node_modules/.bin/ts-refine format && ./node_modules/.bin/ts-refine imports"
  },
  "sideEffects": false,
  "type": "module",
  "types": "types/express-intercept.d.ts"
}
